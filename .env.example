# OpenRouter (required for the clone backend)
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Clone Agent

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="clone-agent"

# Upstash Redis (required for rate limiting in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UDOP document parser (optional — for document understanding in chat)
UDOP_ENDPOINT=
UDOP_API_KEY=

# Multimodal compute endpoint (optional — image, PDF, audio, table query)
COMPUTE_ENDPOINT=

# Storage buckets for S3-compatible Supabase Storage
STORAGE_MEDIA_BUCKET=media
STORAGE_DOCUMENTS_BUCKET=documents

# Ontology-Augmented Generation defaults
DEFAULT_USER_ID=
DEFAULT_WORKSPACE_ID=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Fault tolerance
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Sandbox (disabled by default for safety)
SANDBOX_ENABLED=false
SANDBOX_CWD=/tmp/clone-sandbox

# Backend server
PORT=3001
FRONTEND_URL=http://localhost:3000
